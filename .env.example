# ── Gemini AI ────────────────────────────────────────────────────────────────
# Required for AI case analysis, document generation, and classification.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ── Supabase (optional) ───────────────────────────────────────────────────────
# Required for real user authentication. Without these, the app runs in
# demo mode (mock login, no data persistence).
# Create a free project at: https://supabase.com
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# ── App URL ───────────────────────────────────────────────────────────────────
# The URL where this app is hosted (used for OAuth callbacks etc.)
APP_URL="http://localhost:3000"
